
# For local development, any PostgreSQL instance works, e.g.:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
#
# For Render (or any host without IPv6 egress) connecting to Supabase, use the
# Session Pooler connection string from Supabase → Connect → Session Pooler
# (NOT the direct "db.<project-ref>.supabase.co" host, which is IPv6-only and
# unreachable from Render). It looks like:
# DATABASE_URL=postgresql://postgres.<project-ref>:PASSWORD@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://user:password@host:5432/dbname
SECRET_KEY=change_me_to_a_long_random_string
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_PASSWORD=
GEMINI_API_KEY=
